# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=mgkk
POSTGRES_DB=mgkk
POSTGRES_PASSWORD=local-dev-password
# Host port mapped to the container's 5432
POSTGRES_PORT=5433

# Host-facing URL for Alembic, pytest, and local (venv) runs. It reaches the
# Docker Postgres through the published port above. Keep it in sync with the
# POSTGRES_* values. Compose services get their own DATABASE_URL that points at
# the `postgres` service name instead.
DATABASE_URL=postgresql+asyncpg://mgkk:local-dev-password@localhost:5433/mgkk
# Disposable database used by the model tests; never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://mgkk:local-dev-password@localhost:5433/mgkk_test

# --- Monitoring ---
# Where the API reaches Prometheus. Inside Compose this is the service name;
# for local (venv) runs the default is http://localhost:9090.
PROMETHEUS_URL=http://prometheus:9090

# --- Ping poller worker ---
# How often the worker checks PostgreSQL for devices that are due.
WORKER_TICK_SECONDS=5
# Port the worker exposes its /metrics endpoint on (Prometheus scrapes it).
WORKER_METRICS_PORT=9101
# Required to create or use encrypted SNMP / RouterOS API credential profiles.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-password
