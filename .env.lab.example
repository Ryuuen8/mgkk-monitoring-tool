# Lab-only credentials; replace these values and never reuse production secrets.
LAB_SNMP_V2C_COMMUNITY=replace-with-random-lab-v2-community
LAB_SNMP_V3_USER=lab-monitor
LAB_SNMP_V3_AUTH_PASSPHRASE=replace-with-random-v3-auth-passphrase
LAB_SNMP_V3_PRIV_PASSPHRASE=replace-with-random-v3-privacy-passphrase
LAB_ROUTEROS_USER=lab-monitor
LAB_ROUTEROS_PASSWORD=replace-with-random-routeros-password
LAB_POLLER_SUBNET=172.30.50.0/24
# Set either to false to skip that target's checks when it is not deployed.
LAB_SNMP_REQUIRED=true
LAB_ROUTEROS_REQUIRED=true

# Optional Cisco IOS-XE containerlab node (see deploy/lab/cisco/README.md).
# Requires a licensed vrnetlab image. Leave LAB_CISCO_HOST empty to skip the
# Cisco checks; set it to the node's management IP after deploying the node.
CISCO_IOSXE_IMAGE=vrnetlab/cisco_csr1000v:17.03.04
LAB_CISCO_HOST=
LAB_CISCO_SNMP_V3_USER=lab-monitor
LAB_CISCO_RESTCONF_USER=lab-restconf
LAB_CISCO_RESTCONF_PASSWORD=replace-with-random-cisco-restconf-password
LAB_CISCO_VERIFY_TLS=false
LAB_CISCO_SUBNET=172.31.50.0/24
LAB_CISCO_REQUIRED=false
