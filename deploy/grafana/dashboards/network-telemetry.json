        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(interface_in_bytes_total, device)",
        "includeAll": true,
        "multi": true,
        "name": "device",
        "query": "label_values(interface_in_bytes_total, device)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(interface_in_bytes_total{device=~\"$device\"}, interface)",
        "includeAll": true,
        "multi": true,
        "name": "interface",
        "query": "label_values(interface_in_bytes_total{device=~\"$device\"}, interface)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
