{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "rate(interface_in_bytes_total{device=~\"$device\",interface=~\"$interface\"}[5m]) * 8",
          "legendFormat": "{{device}} / {{interface}} in",
          "refId": "A"
        },
        {
          "expr": "rate(interface_out_bytes_total{device=~\"$device\",interface=~\"$interface\"}[5m]) * 8",
          "legendFormat": "{{device}} / {{interface}} out",
          "refId": "B"
        }
      ],
      "title": "Interface traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "interface_in_link_utilization_ratio{device=~\"$device\",interface=~\"$interface\"}",
          "legendFormat": "{{device}} / {{interface}} in",
          "refId": "A"
        },
        {
          "expr": "interface_out_link_utilization_ratio{device=~\"$device\",interface=~\"$interface\"}",
          "legendFormat": "{{device}} / {{interface}} out",
          "refId": "B"
        }
      ],
      "title": "Link utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "rate(interface_in_errors_total{device=~\"$device\",interface=~\"$interface\"}[5m])",
          "legendFormat": "{{device}} / {{interface}} in errors",
          "refId": "A"
        },
        {
          "expr": "rate(interface_out_errors_total{device=~\"$device\",interface=~\"$interface\"}[5m])",
          "legendFormat": "{{device}} / {{interface}} out errors",
          "refId": "B"
        }
      ],
      "title": "Interface errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "rate(interface_in_discards_total{device=~\"$device\",interface=~\"$interface\"}[5m])",
          "legendFormat": "{{device}} / {{interface}} in discards",
          "refId": "A"
        },
        {
          "expr": "rate(interface_out_discards_total{device=~\"$device\",interface=~\"$interface\"}[5m])",
          "legendFormat": "{{device}} / {{interface}} out discards",
          "refId": "B"
        }
      ],
      "title": "Interface discards",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "device_cpu_usage_percent{device=~\"$device\"}",
          "legendFormat": "{{device}} CPU",
          "refId": "A"
        }
      ],
      "title": "Device CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "device_memory_usage_bytes{device=~\"$device\"}",
          "legendFormat": "{{device}} memory used",
          "refId": "A"
        }
      ],
      "title": "Device memory",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "mgkk",
    "network"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "name": "datasource",
        "options": [],
